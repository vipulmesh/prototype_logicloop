generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) name String email String @unique password String role String @default("CANDIDATE") image String? profile CandidateProfile? recruiter Recruiter? applications Application[] createdAt DateTime @default(now()) }
model CandidateProfile { id String @id @default(cuid()) userId String @unique headline String? bio String? location String? portfolio String? experience Int @default(0) user User @relation(fields:[userId],references:[id]) skills Skill[] projects Project[] certificates Certificate[] hackathons Hackathon[] talentScore TalentScore? }
model Recruiter { id String @id @default(cuid()) userId String @unique company String title String user User @relation(fields:[userId],references:[id]) }
model Skill { id String @id @default(cuid()) name String level Int candidateId String candidate CandidateProfile @relation(fields:[candidateId],references:[id]) }
model Project { id String @id @default(cuid()) name String description String tech String stars Int @default(0) candidateId String? candidate CandidateProfile? @relation(fields:[candidateId],references:[id]) }
model Certificate { id String @id @default(cuid()) name String issuer String issuedAt DateTime candidateId String candidate CandidateProfile @relation(fields:[candidateId],references:[id]) }
model Hackathon { id String @id @default(cuid()) name String placement String project String innovation Int candidateId String candidate CandidateProfile @relation(fields:[candidateId],references:[id]) }
model Job { id String @id @default(cuid()) title String company String location String type String skills String salary String description String createdAt DateTime @default(now()) applications Application[] }
model Assessment { id String @id @default(cuid()) title String category String score Int status String candidateName String createdAt DateTime @default(now()) }
model Interview { id String @id @default(cuid()) candidateName String role String technical Int communication Int confidence Int recommendation String scheduledAt DateTime }
model Presentation { id String @id @default(cuid()) title String owner String innovation Int business Int technical Int presentation Int createdAt DateTime @default(now()) }
model TalentScore { id String @id @default(cuid()) candidateId String @unique overall Int coding Int projects Int innovation Int leadership Int problemSolving Int communication Int consistency Int community Int candidate CandidateProfile @relation(fields:[candidateId],references:[id]) }
model Application { id String @id @default(cuid()) userId String jobId String status String @default("APPLIED") match Int user User @relation(fields:[userId],references:[id]) job Job @relation(fields:[jobId],references:[id]) createdAt DateTime @default(now()) }
